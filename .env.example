# Copy to .env.local and fill in. Leave Supabase blank to use a local JSON file in dev.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Your passcode: opens every account. Give others a per-account share link instead.
# Leave blank to disable the gate in dev.
APP_PASSCODE=
# Any long random string; used to sign the login cookie.
COOKIE_SECRET=
